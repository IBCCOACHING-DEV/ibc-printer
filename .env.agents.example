# ==============================================================
# Exemplos de configuração para múltiplos agentes de impressão
# Copie o bloco desejado para o .env de cada máquina/notebook
# ==============================================================

# Variáveis compartilhadas (iguais em todos os agentes):
#
# NODE_ENV=production
# PORT=3000
# JWT_SECRET=<mesmo valor em todos>
# JWT_EXPIRES_IN=24h
# REDIS_HOST=localhost
# REDIS_PORT=6379
# DEFAULT_PRINTER=
# PRINT_TIMEOUT=30000
# ALLOWED_ORIGINS=http://localhost:3000
# PRINTER_HUB_ENABLED=true
# PRINTER_HUB_BASE_URL=https://<url-do-checkin>/api/v1/printer-hub
# PRINTER_HUB_API_TOKEN=<API_SERVICE_TOKEN do check-in>
# PRINTER_HUB_EVENT_ID=evento-sp-2026
# PRINTER_HEARTBEAT_INTERVAL_MS=30000
# PRINTER_CLAIM_INTERVAL_MS=1500
# PRINTER_CLAIM_BATCH_SIZE=1

# ==============================================================
# AGENTE A — Notebook Credenciamento A (já existente no .env)
# ==============================================================
# PRINTER_AGENT_KEY=agent-notebook-a
# PRINTER_AGENT_NAME=Notebook Credenciamento A
# PRINTER_UID_PREFIX=agent-a://

# ==============================================================
# AGENTE B — Notebook Credenciamento B
# ==============================================================
PRINTER_AGENT_KEY=agent-notebook-b
PRINTER_AGENT_NAME=Notebook Credenciamento B
PRINTER_UID_PREFIX=agent-b://

# ==============================================================
# AGENTE C — Notebook Credenciamento C
# ==============================================================
PRINTER_AGENT_KEY=agent-notebook-c
PRINTER_AGENT_NAME=Notebook Credenciamento C
PRINTER_UID_PREFIX=agent-c://

# ==============================================================
# AGENTE D — Notebook Credenciamento D
# ==============================================================
PRINTER_AGENT_KEY=agent-notebook-d
PRINTER_AGENT_NAME=Notebook Credenciamento D
PRINTER_UID_PREFIX=agent-d://

# ==============================================================
# AGENTE E — Notebook Credenciamento E
# ==============================================================
PRINTER_AGENT_KEY=agent-notebook-e
PRINTER_AGENT_NAME=Notebook Credenciamento E
PRINTER_UID_PREFIX=agent-e://

# ==============================================================
# AGENTE F — Notebook Credenciamento F
# ==============================================================
PRINTER_AGENT_KEY=agent-notebook-f
PRINTER_AGENT_NAME=Notebook Credenciamento F
PRINTER_UID_PREFIX=agent-f://
