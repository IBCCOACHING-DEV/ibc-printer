{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "../generated/prisma-local/**/*",
        "outDir": "dist/generated",
        "watchAssets": true
      },
      {
        "include": "../assets/fonts/**/*",
        "outDir": "dist/assets",
        "watchAssets": true
      },
      {
        "include": "../assets/bin/**/*",
        "outDir": "dist/assets",
        "watchAssets": true
      }
    ]
  }
}
