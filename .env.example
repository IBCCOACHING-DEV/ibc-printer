NODE_ENV=
PORT=

JWT_SECRET=
JWT_EXPIRES_IN=

REDIS_HOST=
REDIS_PORT=

DEFAULT_PRINTER=
PRINT_TIMEOUT=

ALLOWED_ORIGINS=

PRINTER_HUB_ENABLED=false
# Shared MySQL database used by both check-in and ibc-printer
PRINTER_DATABASE_HOST=
PRINTER_DATABASE_PORT=3306
PRINTER_DATABASE_USER=
PRINTER_DATABASE_PASSWORD=
PRINTER_DATABASE_NAME=
PRINTER_DATABASE_POOL=10

# Optional legacy HTTP settings. They can stay empty when using direct DB access.
PRINTER_HUB_BASE_URL=
PRINTER_HUB_API_TOKEN=
PRINTER_HUB_EVENT_ID=
PRINTER_AGENT_KEY=
PRINTER_AGENT_NAME=

# Optional prefix for printer_uid, for example: event-a://
PRINTER_UID_PREFIX=

# Optional JSON map to keep the same logical printer id across computers.
# Example:
# PRINTER_IDENTITY_MAP={"usbprint\\brotherql-810w\\123456":"impressora-1","usbprint\\brotherql-810w\\654321":"impressora-2"}
PRINTER_IDENTITY_MAP={}

PRINTER_HEARTBEAT_INTERVAL_MS=30000
PRINTER_CLAIM_INTERVAL_MS=1500
PRINTER_CLAIM_BATCH_SIZE=1